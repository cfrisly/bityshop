{
    "name": "cfrisly/bityshop",
    "description": "Bity Shop - tienda en línea basada en Vanilo",
    "keywords": [
        "vanilo",
        "laravel",
        "ecommerce"
    ],
    "license": "MIT",
    "type": "project",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.4",
        "ext-gd": "*",
        "guzzlehttp/guzzle": "^7.4",
        "konekt/appshell": "^4.19",
        "laravel/framework": "^12.69",
        "laravel/tinker": "^2.10",
        "laravel/ui": "^4.6",
        "vanilo/admin": "^6.0",
        "vanilo/adyen": "^5.0",
        "vanilo/braintree": "^4.0",
        "vanilo/euplatesc": "^6.0",
        "vanilo/framework": "^6.1",
        "vanilo/mollie": "^4.1",
        "vanilo/netopia": "^4.2",
        "vanilo/paypal": "^4.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.15",
        "spatie/laravel-ignition": "^2.9",
        "fakerphp/faker": "^1.23",
        "laravel/dusk": "^8.3",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
