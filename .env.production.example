# ============================================================
#  Bity Shop - variables de entorno para PRODUCCION
#  Copia este archivo como .env en el servidor y completa los valores.
#  Nunca subas el .env real al repositorio.
# ============================================================

APP_NAME="Bity Shop"
APP_ENV=production
APP_KEY=                      # se genera con: php artisan key:generate
APP_DEBUG=false               # SIEMPRE false en produccion (true expone errores y datos)
APP_URL=https://tudominio.com # con https; activa URL::forceScheme('https')
APP_TIMEZONE=America/Guatemala
APP_LOG_LEVEL=warning
LOG_CHANNEL=daily

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bityshop
DB_USERNAME=bityshop
DB_PASSWORD=                  # usuario propio, no root

# Un solo servidor: file sirve. Con varios servidores usa redis o database.
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true    # cookies solo por https
QUEUE_DRIVER=sync

# Correo (recuperacion de contrasena). Ejemplo con un proveedor SMTP.
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=ventas@tudominio.com
MAIL_FROM_NAME="Bity Shop"

# Pasarelas: completa solo las que vayas a usar (ver docs/PRODUCCION.md)
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=
# PAYPAL_SANDBOX=false
# PAYPAL_RETURN_URL=https://tudominio.com/payment/paypal/return
# PAYPAL_CANCEL_URL=https://tudominio.com/payment/paypal/cancel

# Carrito (ver config/tienda.php). Las tarifas de envio se configuran en el admin: Metodos de envio
ENVIO_ZONA=Guatemala
# Deja RECOGER_LUGAR vacio para ocultar la opcion de recoger en tienda
RECOGER_LUGAR=
RECOGER_HORARIO="de 9:00 a 17:00"
RECOGER_DIAS=1
