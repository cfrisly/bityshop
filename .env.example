APP_NAME="Vanilo Demo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_LOG_LEVEL=debug
APP_URL=http://localhost

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=homestead
DB_USERNAME=homestead
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_DRIVER=sync

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo (verificación de cuenta, restablecer contraseña)
# MAIL_MAILER=log no envía nada: guarda los correos en storage/logs/laravel.log (pruebas)
# MAIL_MAILER=smtp envía de verdad. Gmail: smtp.gmail.com, 587, tls y una "contraseña de aplicación"
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-responder@bityshop.com
MAIL_FROM_NAME="BityShop"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=

ADYEN_IS_TEST=true
ADYEN_API_KEY="" # Find at Adyen Customer Area -> Developers -> API credentials
ADYEN_MERCHANT_ACCOUNT="YourECOM" # Obtain the merchant key from Adyen Customer Area
ADYEN_CLIENT_KEY="" # Find at Adyen Customer Area -> Developers -> API credentials


# Carrito (ver config/tienda.php). Las tarifas de envio se configuran en el admin: Metodos de envio
ENVIO_ZONA=Guatemala
# Deja RECOGER_LUGAR vacio para ocultar la opcion de recoger en tienda
RECOGER_LUGAR=
RECOGER_HORARIO="de 9:00 a 17:00"
RECOGER_DIAS=1
